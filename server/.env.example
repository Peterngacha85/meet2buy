# Copy to .env and fill in. Never commit .env.

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=                # public https URL (ngrok in dev) — used for M-Pesa callbacks
JWT_SECRET=                    # at least 32 random characters
JWT_EXPIRES_DAYS=7
COOKIE_SAME_SITE=lax           # 'none' while frontend is on *.vercel.app and API on *.onrender.com; 'lax' once both are on the client's domain

# Database
MONGO_URI=mongodb://127.0.0.1:27017/meet2buy

# Owner admin — set up on every server start. Change ADMIN_PASSWORD and restart to reset it.
# Changing ADMIN_EMAIL disables the previous owner account. More admins are added from the dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=                # at least 12 characters
ADMIN_NAME=Meet2buy Admin
ADMIN_PHONE=                   # optional, e.g. 0712345678

# LiveKit (Sprint 4)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudinary (Sprint 2) - image uploads. Check with: npm run check:cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja (Sprint 6)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
